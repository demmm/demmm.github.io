---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import StatStrip from "../components/StatStrip.astro";
import Features from "../components/Features.astro";
import Why from "../components/Why.astro";
import Gallery from "../components/Gallery.astro";
import Activities from "../components/Activities.astro";
import VideoSection from "../components/VideoSection.astro";
import Stay from "../components/Stay.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
---

<Layout>
  <Header />
  <Hero />
  <StatStrip />
  <Features />
  <Why />
  <Gallery />
  <Activities />
  <VideoSection />
  <Stay />
  <Contact />
  <Footer />
</Layout>

<script>
  import { animate, stagger, inView, scroll } from "motion";

  inView(
    ".scrolling",
    (element) => {
      animate(element, { opacity: [0, 1], y: [50, 0] }, { ease: [0.39, 0.24, 0.3, 1], duration: 2 });

      const cards = element.querySelectorAll(".card");
      if (cards.length > 0) {
        animate(cards, { opacity: [0, 1], y: [25, 0] }, { type: "spring", delay: stagger(0.8, { startDelay: 0.5 }) });
      }
      const images = element.querySelectorAll(".image");
      if (images.length > 0) {
        animate(images, { opacity: [0, 1], y: [0, 0] }, { ease: [0.39, 0.24, 0.3, 1], duration: 6 }, { startDelay: .95 });
      }
    },
    { amount: 0.25 }
  );

  //inView(".card", ({ target }) => {
  //  animate(target, { opacity: 1, y: [50, 0] }, { delay: stagger(0.05) })
  //});

  //inView(".scrolling", ({ target }) => {
  //  animate(target, { opacity: [0, 1], y: [50, 0] });
  //});
  
