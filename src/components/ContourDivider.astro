---
// The recurring signature motif: a mountain elevation profile, like the
// line you'd see on a trail map or lift-pass panel. `flip` mirrors it
// vertically so it can cap either the top or bottom of a section.
interface Props {
  tone?: "snow" | "ink";
  flip?: boolean;
  label?: string;
}

const { tone = "snow", flip = false, label } = Astro.props;
const stroke = tone === "ink" ? "#10202e" : "#f7f7f2";
const fill = tone === "ink" ? "#10202e" : "#f7f7f2";
---

<div class="contour" class:list={[{ flip }]} aria-hidden="true">
  <svg viewBox="0 0 1200 90" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
    <path
      d="M0,90 L0,58 L60,40 L110,55 L170,20 L230,48 L290,30 L360,52 L430,15 L500,46 L560,32 L630,50 L700,10 L760,42 L830,28 L900,50 L970,18 L1040,44 L1110,30 L1200,50 L1200,90 Z"
      fill={fill}
    ></path>
    <path
      d="M0,58 L60,40 L110,55 L170,20 L230,48 L290,30 L360,52 L430,15 L500,46 L560,32 L630,50 L700,10 L760,42 L830,28 L900,50 L970,18 L1040,44 L1110,30 L1200,50"
      fill="none"
      stroke={stroke}
      stroke-width="0"
    ></path>
  </svg>
  {label && <span class="contour__label">{label}</span>}
</div>

<style>
  .contour {
    position: relative;
    line-height: 0;
    background: transparent;
  }

  .contour.flip svg {
    transform: scaleY(-1.5);
  }

  .contour__label {
    
    right: clamp(1rem, 4vw, 2.5rem);
    top: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--marker-dark);
  }

  .contour.flip .contour__label {
    top: auto;
    bottom: 0.6rem;
  }
</style>
