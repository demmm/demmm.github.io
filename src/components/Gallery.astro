---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

const images = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/gallery/*.{jpg,jpeg,png,gif,webp}', 
  { eager: true }
);

const imageList = Object.values(images).map((file) => file.default);
---
<section class="section section--stone" id="galerij">
  <div class="container">
    <p class="eyebrow">Galerij</p>
    <h2>Salzburgerland, Mühlbach & het appartement</h2>

    <div class="gallery-grid">
      {
        imageList.map((img) => (
          <a href={`#lightbox-${img.src}`} class="gallery-grid__item" aria-label={`Vergroot: ${img.alt}`}>
          <Image 
            src={img} 
            alt="Gallery image" 
            loading="lazy" 
            //class="lightbox"
            formats={['avif', 'webp', 'original']}
            data-full-res={img.src}
          />
          </a>
        ))
      }
    </div>
  </div>
  
  {
    imageList.map((img) => (
      <div class="lightbox" id={`lightbox-${img.src}`}>
        <a href="#galerij" class="lightbox__scrim" aria-label="Sluiten"></a>
        <figure class="lightbox__figure">
          <img src={img.src} alt={img.alt} />
          <figcaption>{img.alt}</figcaption>
        </figure>
        <a href="#galerij" class="lightbox__close" aria-label="Sluiten">✕</a>
      </div>
    ))
  }
  
</section>

<style>
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: .7rem;
  }

  .gallery-grid__item {
    display: block;
    overflow: hidden;
    border-radius: var(--radius);
    aspect-ratio: 4 / 3;
  }

  .gallery-grid__item img {
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .gallery-grid__item:hover img {
    transform: scale(1.06);
  }
  
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: none;
    align-items: center;
    justify-content: center;
  }

  .lightbox:target {
    display: flex;
  }

  .lightbox__scrim {
    position: absolute;
    inset: 0;
    background: rgba(16, 32, 46, 0.92);
  }

  .lightbox__figure {
    position: relative;
    max-width: min(90vw, 1000px);
    max-height: 86vh;
    margin: 0;
    text-align: center;
  }

  .lightbox__figure img {
    max-width: 100%;
    max-height: 78vh;
    border-radius: var(--radius);
  }

  .lightbox__figure figcaption {
    color: var(--text-on-dark-soft);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    margin-top: 0.75rem;
  }

  .lightbox__close {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    color: var(--text-on-dark);
    text-decoration: none;
    font-size: 1.1rem;
    border: 1px solid rgba(238, 241, 238, 0.4);
    border-radius: 50%;
    width: 2.4rem;
    height: 2.4rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
</style>   
