---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

const images = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/gallery/*.{jpg,jpeg,png,gif,webp}', 
  { eager: true }
);

const imageList = Object.values(images).map((file) => file.default);
---

<section class="section section--stone" id="galerij">
  <div class="container">
    <p class="eyebrow">Galerij</p>
    <h2>Salzburgerland, Mühlbach & het appartement</h2>

    <div class="gallery-grid">
      {
        imageList.map((img, index) => (
          <button 
            class="gallery-grid__item" 
            aria-label={`Vergroot: ${img.alt}`}
            data-index={index}
            style="background: none; border: none; padding: 0; cursor: pointer;"
          >
            <Image 
              src={img} 
              alt="Gallery image"
              loading="lazy" 
              formats={['avif', 'webp', 'original']}
              class="thumbnail"
              // Pass the full resolution src to the button for JS to pick up
              //data-full-src={img.src} 
            />
          </button>
        ))
      }
    </div>
  </div>
</section>

<div class="lightbox-overlay" id="lightbox" aria-hidden="true">
  <button class="lightbox__scrim" aria-label="Sluiten"></button>
  <figure class="lightbox__figure">
    <!-- Initial src is empty, populated by JS -->
    <img id="lightbox-img" src="" alt="Gallery Image" />
    <figcaption id="lightbox-caption"></figcaption>
  </figure>
  <button class="lightbox__close" aria-label="Sluiten">✕</button>
</div>

<style>
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: .7rem;
  }

  .gallery-grid__item {
    display: block;
    overflow: hidden;
    border-radius: 10px;
    aspect-ratio: 4 / 3;
  }

  .gallery-grid__item img {
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .gallery-grid__item:hover img {
    transform: scale(1.06);
  }

  /* Basic CSS to support the JS logic */
  .lightbox-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.9);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1000;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease; /* Fallback for backdrop */
  }

  .lightbox-overlay.active {
    opacity: 1;
    pointer-events: auto;
  }

  .lightbox__figure {
    margin: 0;
    max-width: 90vw;
    max-height: 90vh;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  #lightbox-img {
    max-width: 100%;
    max-height: 80vh;
    object-fit: contain;
    border-radius: 4px;
    /* Ensure it's visible when active, hidden otherwise */
    display: block; 
  }

  figcaption:empty {
    display: none;
  }

  .lightbox__scrim, .lightbox__close {
    position: absolute;
    background: none;
    border: none;
    cursor: pointer;
  }

  .lightbox__scrim {
    inset: 0;
  }
  .lightbox__close {
    top: 20px;
    right: 20px;
    color: white;
    font-size: 2rem;
  }
</style> 

<script>
  import { animateView, spring } from "motion";

  const grid = document.querySelector(".gallery-grid");
  const lightbox = document.getElementById("lightbox");
  const lightboxImg = document.getElementById("lightbox-img");
  const lightboxCaption = document.getElementById("lightbox-caption");
  // Select the buttons
  const thumbnails = document.querySelectorAll(".gallery-grid__item");

  thumbnails.forEach((thumb) => {
    thumb.addEventListener("click", (e) => {
      e.preventDefault();

      const imgElement = thumb.querySelector("img");

      const fullSrc = imgElement?.src; 
      const altText = imgElement?.alt || "";

      if (!fullSrc) {
        console.error("No image source found!");
        return;
      }

      const update = () => {
        lightboxImg.src = fullSrc;
        lightboxImg.alt = altText;
        lightboxCaption.textContent = altText;
        lightbox.setAttribute("aria-hidden", "false");
        lightbox.classList.add("active");
      };

      // Animate from the rendered thumbnail img -> lightbox img
      animateView(update, { 
        transition: { type: spring, stiffness: 300, damping: 25 } 
      })
      .add(imgElement, lightboxImg);
    });
  });

  const closeLightbox = () => {
    const lightboxSrc = lightboxImg.src;
    
    // Find the thumbnail that has an img with this specific src
    const currentThumb = Array.from(thumbnails).find(t => {
      const tImg = t.querySelector("img");
      return tImg && tImg.src === lightboxSrc;
    });

    const imgToShrink = currentThumb ? currentThumb.querySelector("img") : null;

    if (!imgToShrink) {
        // Fallback if no match found (just hide)
        lightbox.classList.remove("active");
        lightboxImg.src = "";
        return;
    }

    const update = () => {
      lightbox.classList.remove("active");
      lightbox.setAttribute("aria-hidden", "true");
    };

    const animation = animateView(update, { 
      transition: { type: spring, stiffness: 300, damping: 25 } 
    })
    .add(lightboxImg, imgToShrink)
    .exit({ opacity: [1, 0], scale: [1, 0.95] });

    animation.finished.then(() => {
      lightboxImg.src = "";
      lightboxCaption.textContent = "";
    });
  };

  document.querySelector(".lightbox__scrim")?.addEventListener("click", closeLightbox);
  document.querySelector(".lightbox__close")?.addEventListener("click", closeLightbox);
  
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && lightbox.classList.contains("active")) {
      closeLightbox();
    }
  });
</script>   
