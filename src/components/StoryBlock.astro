---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { skiSection, summerSection } from '../data/site';

interface Props {
  eyebrow: string;
  title: string;
  paragraphs: string[];
  image: string;
  reverse?: boolean;
}

const { eyebrow, title, paragraphs, image, reverse = false } = Astro.props;
const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/*.{png,jpg,jpeg,gif}');
const pathMap = {
  winter: skiSection.image,
  summer: summerSection.image
};

// Determine key based on reverse flag
const key = reverse ? 'summer' : 'winter';
const imagePath = pathMap[key];
if (!images[imagePath]) {
  throw new Error(`Image not found: ${imagePath}`);
}
const myImageModule = await images[imagePath]();
const myImage = myImageModule.default;
---

<div class:list={["story", { reverse }]}>
  <div class="story__text scrolling">
    <p class="eyebrow">{eyebrow}</p>
    <h2>{title}</h2>
    {paragraphs.map((p) => <p>{p}</p>)}
  </div>
  <div class="story__image">
    <Image src={myImage} alt={title} layout='constrained' width={600} height={600} />
  </div>
</div>

<style>
  .story {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: center;
    padding-block: clamp(2.5rem, 4vw, 3.5rem);
  }

  .story.reverse {
    grid-template-columns: 0.9fr 1.1fr;
  }

  .story.reverse .story__text {
    order: 2;
  }

  .story__text p:not(.eyebrow) {
    color: var(--text-soft);
  }

  .story__image img {
    border-radius: 10px;
    box-shadow: var(--shadow-card);
  }

  @media (max-width: 860px) {
    .story,
    .story.reverse {
      grid-template-columns: 1fr;
    }

    .story.reverse .story__text {
      order: 0;
    }

    .story__image {
      order: -1;
    }
  }
</style>
